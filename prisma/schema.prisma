// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// NextAuth.js Models
// ========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ========================================
// Application Models
// ========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts    Account[]
  sessions    Session[]
  courses     Course[]
  semesters   Semester[]
  assignments Assignment[]
}

// ========================================
// Semester Model
// ========================================

enum SemesterType {
  A      // סמסטר א'
  B      // סמסטר ב'
  SUMMER // סמסטר קיץ
}

model Semester {
  id        String       @id @default(cuid())
  name      String       // "סמסטר א' תשפ"ה"
  type      SemesterType
  year      Int          // Academic year (e.g., 2024 for תשפ"ה)
  startDate DateTime
  endDate   DateTime
  isActive  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  @@index([userId])
}

model Course {
  id          String   @id @default(cuid())
  name        String
  courseCode  String?  // e.g., "CS101" - for future automation
  credits     Float?   // Course weight/credits (optional)
  color       String?  // For UI display
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterId  String?
  semester    Semester?    @relation(fields: [semesterId], references: [id])
  assignments Assignment[]

  @@index([userId])
  @@index([semesterId])
}

// ========================================
// Assignment Model (formerly Task)
// ========================================

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AssignmentPriority {
  LOW
  MEDIUM
  HIGH
}

model Assignment {
  id          String             @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  weight      Float?             // Percentage of grade (0-100, optional)
  priority    AssignmentPriority @default(MEDIUM)
  status      AssignmentStatus   @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relations
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId])
  @@index([dueDate])
  @@index([status])
}
