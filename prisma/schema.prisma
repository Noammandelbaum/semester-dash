// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// NextAuth.js Models
// ========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ========================================
// Application Models
// ========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  courses       Course[]
  semesters     Semester[]
  assignments   Assignment[]
  preferences   UserPreferences?
  notifications Notification[]
}

// ========================================
// User Preferences Model
// ========================================

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Institution
  institutionId String? // "jct", "tau", etc. - from institutions.ts

  // Notifications
  emailNotifications Boolean @default(false) // Disabled by default
  inAppNotifications Boolean @default(true)
  reminderDaysBefore Int[]   @default([1]) // Default: 24h before only
  quietHoursStart    Int? // Hour (0-23) - null = disabled
  quietHoursEnd      Int?

  // Display
  theme String @default("system") // light/dark/system

  // Onboarding
  onboardingComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// Semester Model
// ========================================

enum SemesterType {
  A      // סמסטר א'
  B      // סמסטר ב'
  SUMMER // סמסטר קיץ
}

model Semester {
  id        String       @id @default(cuid())
  name      String       // "סמסטר א' תשפ"ה"
  type      SemesterType
  year      Int          // Academic year (e.g., 2024 for תשפ"ה)
  startDate DateTime
  endDate   DateTime
  isActive  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  @@index([userId])
}

model Course {
  id          String   @id @default(cuid())
  name        String
  courseCode  String?  // e.g., "CS101" - for future automation
  credits     Float?   // Course weight/credits (optional)
  color       String?  // For UI display
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Moodle sync fields
  moodleId     String?   // Moodle course ID
  moodleUrl    String?   // Full URL to course in Moodle
  lastSyncedAt DateTime? // Last successful sync timestamp

  // Relations
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterId  String?
  semester    Semester?    @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@unique([userId, moodleId]) // Unique moodleId per user
  @@index([userId])
  @@index([semesterId])
}

// ========================================
// Assignment Model (formerly Task)
// ========================================

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AssignmentPriority {
  LOW
  MEDIUM
  HIGH
}

enum AssignmentType {
  ASSIGNMENT // Regular assignment (מטלה)
  QUIZ       // Quiz/exam (בוחן/מבחן)
  FORUM      // Forum post (פורום)
  OTHER      // Other activity types
}

model Assignment {
  id          String             @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  weight      Float?             // Percentage of grade (0-100, optional)
  priority    AssignmentPriority @default(MEDIUM)
  status      AssignmentStatus   @default(NOT_STARTED)
  type        AssignmentType     @default(ASSIGNMENT) // Moodle activity type
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Moodle sync fields
  moodleId               String?   // Moodle assignment/activity ID
  moodleUrl              String?   // Full URL to assignment in Moodle
  moodleSubmissionStatus String?   // "submitted", "draft", "new", etc.
  lastSyncedAt           DateTime? // Last successful sync timestamp

  // Relations
  courseId      String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([moodleId, courseId]) // Prevent duplicate Moodle assignments per course
  @@index([courseId])
  @@index([userId])
  @@index([dueDate])
  @@index([status])
}

// ========================================
// Notification Model
// ========================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // "deadline_reminder" | "assignment_due"
  title     String
  message   String
  actionUrl String?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
}
