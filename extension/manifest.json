{
  "manifest_version": 3,
  "name": "SemesterHub - Moodle Sync",
  "version": "1.0.5",
  "description": "Sync your Moodle courses and assignments to SemesterHub",
  "default_locale": "he",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "*://*.ac.il/*",
    "*://*.edu.il/*",
    "*://semester-dash.vercel.app/*",
    "*://localhost/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ac.il/*",
        "*://*.edu.il/*"
      ],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://semester-dash.vercel.app/*",
        "*://localhost/*"
      ],
      "js": ["content/content-script-webapp.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
